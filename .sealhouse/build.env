# Read by ci/hack/build-image.sh.
IMAGE=rekor-v3
CONTAINERFILE=.sealhouse/Containerfile
BINARIES=/usr/local/bin/rekor-server
WRITABLE_PATHS=/tmp
# Arguments for the image test: the container must start and stay up under a
# random UID.
SMOKE_KEY="ML-DSA-44 /etc/smoke/signer.pem"
SMOKE_ARGS="serve --signer-filepath=/etc/smoke/signer.pem --storage-dir=/tmp/tiles --http-address=0.0.0.0 --grpc-address=0.0.0.0"
LDFLAGS_PKG=sigs.k8s.io/release-utils/version
