# sealhouse build of rekor-server on Red Hat Hardened Images (Hummingbird).
ARG BUILDER
ARG RUNTIME

FROM ${BUILDER} AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY internal/ internal/
ARG LDFLAGS=""
RUN CGO_ENABLED=0 GOFIPS140=v1.26.0 go build -trimpath -ldflags "-buildid= ${LDFLAGS}" \
      -o /out/usr/local/bin/rekor-server ./cmd/rekor-server/posix

FROM ${RUNTIME}
COPY --from=builder /out/usr/local/bin/rekor-server /usr/local/bin/rekor-server
ENTRYPOINT ["/usr/local/bin/rekor-server"]
CMD ["serve"]
